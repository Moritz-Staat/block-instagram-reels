<?xml version="1.0" encoding="utf-8"?>
<!--
  Nothing this app stores may leave the device (R7). Budget state and cached rules are local and
  cheap to recreate; a cloud backup of them would be a privacy cost with no benefit.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
