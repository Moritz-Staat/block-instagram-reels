root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
max_line_length = 120
ktlint_code_style = android_studio
# Composable functions are PascalCase by convention; ktlint's function-naming rule does not know
# that on its own.
ktlint_function_naming_ignore_when_annotated_with = Composable
# Compose previews and composables routinely exceed the default, and splitting them makes the
# layout harder to read rather than easier.
ktlint_function_signature_body_expression_wrapping = default

[*.{yml,yaml,json,xml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[gradlew.bat]
end_of_line = crlf
